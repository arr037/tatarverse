---
import MySubmissions from "@/components/submit/MySubmissions.astro";
import PageHero from "@/components/ui/PageHero.astro";
import { getLocaleFromUrl, useTranslations } from "@/i18n";
import Layout from "@/layouts/Layout.astro";

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
---

<Layout title={t("my.title")} description={t("my.description")} indexRobots={false} classContainer="max-w-3xl">
	<div class="flex w-full min-w-0 flex-col gap-8">
		<PageHero title={t("my.title")} intro={t("my.description")} />
		<MySubmissions />
	</div>
</Layout>
